<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window. On Android 12+ the system splash draws over this and hands
     straight to Flutter's first frame, so anything layered here never reaches the
     screen — the branding comes from the splash attributes in values-v31 and from
     the adaptive launcher icon instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
